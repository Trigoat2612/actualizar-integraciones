# Configurar en Vercel, nunca guardar secretos reales en GitHub
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# OpenAI API (Chat Completions), nunca enviar claves al cliente
ANALYSIS_API_URL=https://api.openai.com/v1/chat/completions
ANALYSIS_API_KEY=
ANALYSIS_MODEL=gpt-4.1-mini

# BLOQUEO DE SEGURIDAD: false permite solo la prueba SINTÉTICA.
# true habilita transcripciones reales y requiere autorización institucional expresa.
AI_PROCESSING_APPROVED=false
